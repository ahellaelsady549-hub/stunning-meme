# Fawry (FawryPay / Accept) — required backend secrets.
# Values are stored as backend secrets, NEVER in frontend code or in git.

# sandbox | production
FAWRY_ENV=
# Merchant code issued by Fawry
FAWRY_MERCHANT_CODE=
# Merchant "Security / Secure key" issued by Fawry (server-side only)
FAWRY_SECURITY_KEY=
# Optional override. Defaults:
#   sandbox    -> https://atfawry.fawrystaging.com
#   production -> https://www.atfawry.com
FAWRY_API_URL=
# Where Fawry redirects the customer back to after payment
# e.g. https://happy-shop-egypt.lovable.app/payment-status
FAWRY_RETURN_URL=
# Server callback (configured inside the Fawry merchant dashboard)
# e.g. https://happy-shop-egypt.lovable.app/api/public/payments/fawry/webhook
FAWRY_CALLBACK_URL=
